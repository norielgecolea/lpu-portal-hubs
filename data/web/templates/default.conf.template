map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       ${NGINX_PORT};
    listen  [::]:${NGINX_PORT};
    server_name  ${SERVER_NAME};

    client_max_body_size 16m;

    # LIT Android package is large; let the download finish on a slow campus link.
    location = /LIT_LPU_V5.apk {
        proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
    }

    # Backend API (Tomcat WAR context)
    location /hubs-portal/ {
        proxy_pass http://${TOMCAT_HOST}:${TOMCAT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # Angular frontend. learnershub.lpulaguna.com and adminportal.lpulaguna.com
    # share this app; the page chooses the hub from the Host header.
    location / {
        proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }
}
