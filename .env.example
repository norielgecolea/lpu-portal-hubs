# Copy to .env and fill in real values:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# Host port. 5432–5437 are used by the other campus systems on a shared machine.
POSTGRES_PORT=5438
# 0.0.0.0 lets other campus systems reach this database. Use 127.0.0.1 for local-only.
POSTGRES_BIND=0.0.0.0

# --- Tomcat ---
TOMCAT_USERNAME=admin
TOMCAT_PASSWORD=change-me
# Host port. 8080–8085 are used by the other campus systems on a shared machine.
TOMCAT_PORT=8086

# --- nginx / Angular ---
# Host ports only. Inside the stack, nginx stays on 80 and Angular stays on 4200.
WEB_PORT=86
ANGULAR_PORT=4206
# learnershub.lpulaguna.com serves the Learner's Hub.
# adminportal.lpulaguna.com serves the Admin Portal.
# Point both Cloudflare public hostnames at this tunnel (HTTP, http://web:80).
SERVER_NAME=learnershub.lpulaguna.com adminportal.lpulaguna.com localhost

# --- App ---
# Leave unset to generate a private signing key in data/secrets on first start.
# Do not commit a real value. Generate one with: openssl rand -base64 32
# APP_JWT_SECRET=

# development = ng serve with proxy.conf.js. production = built static files on :4200.
FRONTEND_MODE=production

# --- Cloudflare Tunnel ---
# From Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=
